# Copie para .env (NÃO versionar). Somente placeholders: gere valores próprios.
# Gere um segredo:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
# Desenvolvimento: vazio gera chave efêmera por processo. Em produção, configure
# APP_ENV=production e uma SECRET_KEY aleatória de pelo menos 32 caracteres.
# NUNCA exponha serviço público com o ambiente de desenvolvimento.
SECRET_KEY=
# Senha das contas de DEMONSTRAÇÃO criadas pelo seed (opcional; se vazio é gerada e impressa)
SEED_PASSWORD=
# DATABASE_URL=sqlite:////data/replay.db   (ou postgresql+psycopg://usuario:senha@host/db — driver não incluído)
# STORAGE_DIR=/data/storage                (privado, fora de qualquer diretório servido)
# CORS_ORIGINS=                            (vazio = mesma origem)
# SIGNED_URL_TTL_S=300
# MAX_VIDEO_BYTES=524288000
# EXPORT_TIMEOUT_S=600
# --- Agentes locais / multiarena (ver docs/CAPACIDADE-E-ARMAZENAMENTO.md) ---
# AGENT_HEARTBEAT_S=30            (online ≤ 2×, delayed ≤ 6×, offline depois)
# AGENT_SYNC_BATCH_MAX=200
# STORAGE_SAMPLE_MIN_INTERVAL_S=60
# ALLOW_AGENT_VIDEO_UPLOAD=true   (legado; use false para impor 'vídeo fica na arena')
# --- Preparação para redundância da API central (ver docs/ALTA-DISPONIBILIDADE.md) ---
# NODE_ID=central-1
# NODE_ROLE=primary               (primary|standby; standby recusa escrita de agentes com 503)
# CENTRAL_EPOCH=1                 (incrementar a CADA promoção; token de fencing)
# --- Entrega por relay, render local e segurança do agente (ver docs/ENTREGA-E-SEGURANCA-DO-AGENTE.md) ---
# RELAY_WINDOW_BYTES=4194304      (janela máxima por resposta inline/trecho)
# RELAY_TIMEOUT_S=20              (espera pelo agente por trecho)
# RELAY_SPOOL_DIR=/var/tmp/replay-agora-relay   (temporário; fora do STORAGE_DIR; apagado após a entrega)
# AGENT_REACHABLE_S=90            (arena "acessível" se o agente falou nos últimos N s)
# RENDER_LEASE_S=600
# RENDER_MAX_ATTEMPTS=3
# AGENT_TOKEN_TTL_DAYS=90
# AGENT_ROTATE_BEFORE_DAYS=7
# AGENT_ROTATE_GRACE_S=600
# AGENT_REQUIRE_SIGNATURE=false   (true: exige HMAC de todos os agentes)
# AGENT_MTLS_MODE=off             (off|optional|required; proxy valida o certificado)
# AGENT_MTLS_HEADER=X-Client-Cert-Sha256
