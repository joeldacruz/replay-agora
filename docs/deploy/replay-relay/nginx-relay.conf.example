# Inserir no server correto do NGINX central.
# Verificar outros proxies existentes antes da aplicacao.
# A rota deve preservar as demais diretivas de proxy
# e os cabecalhos necessarios para autenticacao.
location ^~ /api/agent/v1/relay/ {
    client_max_body_size 8m;
    proxy_pass http://127.0.0.1:18082;
}
